model Profile {
  id            String    @id @default(cuid())
  user_id       String
  name          String
  username      String    @unique
  avatarMediaId String?
  coverPhotoId  String?
  bio           String?
  location      String?
  hometown      String?
  last_accessed DateTime?
  created_at    DateTime  @default(now())
  deleted_at    DateTime?

  // FK to Media (avatar & cover)
  avatar     Media?      @relation("AvatarMedia", fields: [avatarMediaId], references: [id])
  coverPhoto Media?      @relation("CoverMedia", fields: [coverPhotoId], references: [id])
  education  Education[]

  // Relations
  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  media         Media[]
  contact_infos ContactInfo[]
  reports       Report[]
  appUsages     AppUsage[]
  collections   Collection[]
  channels      Channel[]
  videos        Video[]
  communities   Community[]
  // posts         Post[]
  posts         Post[]
  comments      Comment[]

  followers     Follow[]       @relation("followers")
  following     Follow[]       @relation("following")
  reactions     Reaction[]
  stories       Story[]
  subscriptions Subscription[]

  @@map("profiles")
}

enum PrivacyStatus {
  Public  @map("public")
  Friends @map("friends")
  OnlyMe  @map("only-me")
}

/**
 * - user_id (FK users.id)
 * - name
 * - username (unique)
 * - avatar_media_id (nullable)
 * - bio
 * - profile_type ENUM ('personal','child','business','anonymous')
 * - date_of_birth (nullable)
 * - is_minor BOOLEAN
 * - is_active BOOLEAN DEFAULT TRUE
 * - created_at
 */
