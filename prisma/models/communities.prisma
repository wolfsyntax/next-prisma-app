model Community {
  id                  String           @id @default(cuid())
  ownerId             String?          @map("owner_id")
  coverMediaId        String?          @map("cover_photo_id")
  name                String
  description         String           @db.Text
  privacy             CommunityPrivacy @default(Public)
  postApprovalRequest Boolean          @default(false) @map("post_approval_request")
  allowAnonymousPost  Boolean          @default(false) @map("allow_anonymous_post")
  joinRequestApproval Boolean          @default(false) @map("join_request_approval")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime?        @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")
  profile             Profile?         @relation(fields: [ownerId], references: [id])
  media               Media?           @relation(fields: [coverMediaId], references: [id])
  posts               Post[]

  @@map("communities")
}

enum CommunityPrivacy {
  Public
  Private
  Secret
}
