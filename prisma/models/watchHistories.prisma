model WatchHistory {
  id                String    @id @default(cuid())
  profileId         String    @map("profile_id")
  videoId           String    @map("video_id")
  progressInSeconds Int       @default(0) @map("progress")
  lastWatchedAt     DateTime? @map("last_watched_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // profile Profile @relation(fields: [profileId], preferences: [id])
  viewer Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  video  Video   @relation(fields: [videoId], references: [id])

  @@map("watch_history")
}
