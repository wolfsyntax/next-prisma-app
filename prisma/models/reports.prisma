model Report {
  id             String           @id @default(cuid())
  reporterId     String           @map("reporter_id")
  reportableId   String?          @map("reportable_id")
  reportableType ReportType       @default(Post) @map("reportable_type")
  reason         String?
  status         ResolutionStatus @default(Pending)
  createdAt      DateTime         @default(now()) @map("created_at")
  reporter       Profile          @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

enum ReportType {
  Post      @map("post")
  Comment   @map("comment")
  Profile   @map("profile")
  Community @map("community")
  Message   @map("message")
  Product   @map("product")
}

enum ResolutionStatus {
  Pending  @map("pending")
  Reviewed @map("reviewed")
  Resolved @map("resolved")
}
